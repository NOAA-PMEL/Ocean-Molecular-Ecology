@article {Waters2026.09.29.755491,
	author = {Waters, Tanner and Gold, Zachary and Parker, Emily and Simon, Olivia and Jenny, Liam and Ambrose, Richard F. and Barber, Paul H. and Eagle, Robert A.},
	title = {Using Community Science and eDNA to Inform a State-Designed Marine Protected Area Monitoring Program: A Case Study from Malibu, California},
	elocation-id = {2026.09.29.755491},
	year = {2026},
	doi = {10.64898/2026.09.29.755491},
	publisher = {Cold Spring Harbor Laboratory},
	abstract = {Management of marine protected areas (MPAs) require long-term monitoring and evaluation that is often limited by the cost and effort of conventional visual based surveys. We evaluated a community science-based eDNA approach to MPA monitoring over two years in the Point Dume State Marine Reserve, the Point Dume State Marine Conservation Area, and two paired unprotected reference sites. Across the sampling period, we detected 119 species of fish and marine mammals, including 19 of the 22 regional management-priority species for Southern CA MPAs. Protected and unprotected comparison sites were broadly similar in overall assemblage with 93 species shared across all sites. Multivariate analyses revealed site-level differences, although season and year explained more variation than protection status. Species presence also shifted during a La-Ni{\~n}a transition, highlighting the importance of long-term monitoring under different climatological contexts. Community scientists greatly expanded the temporal and spatial scope of eDNA sampling and generated high-quality data. Subsampling analysis showed that quarterly sampling, with three sample replicates and sequencing depths between 700k-990k, recovered 95\% of observed biodiversity of the full time series. These results demonstrate that a community science-based eDNA program could provide a standardized, scalable, low-cost, and management-relevant approach for long-term monitoring across California{\textquoteright}s MPA network.Competing Interest StatementThe authors have declared no competing interest.},
	URL = {https://www.biorxiv.org/content/early/2026/09/30/2026.09.29.755491},
	eprint = {https://www.biorxiv.org/content/early/2026/09/30/2026.09.29.755491.full.pdf},
	journal = {Scientific Reports}
}
@article{10.3897/mbmg.10.174450,
	author = {Alison W. Watts and Zachary Gold and Nastassia V. Patin and Nicolaus G. Adams and Jacoby D. Baker and Fouad El Baidouri and Erin Grey and Ann E. Holmes and Kym Jacobson and Sean Jungbluth and Tadashi Kajita and Anders Kiledal and Matthew A. Lemay and Enrique Montes and Frank E. Muller-Karger and Jeffrey Miller and Matthew B. Ogburn and Kathleen J. Pitz and Katherine Silliman and Andrew Thompson and Luke R. Thompson},
	title = {Guidance and best practices for species identification using eDNA metabarcoding – When do you call a cod a cod?},
	volume = {10},
	number = {},
	year = {2026},
	doi = {10.3897/mbmg.10.174450},
	publisher = {Pensoft Publishers},
	abstract = {With the rapid uptake of environmental DNA (eDNA) metabarcoding for a wide range of conservation and management uses, there is a growing need for guidance and best practices for species identification. A range of methodological and interpretive decisions influences taxa assignment. Here we provide a review and perspective of pitfalls and issues that can impact accurate taxonomic assignment across the full eDNA metabarcoding workflow: primer selection, lab handling, bioinformatics, taxonomic assignment, and communication of results. This paper addresses the complexities and challenges of the metabarcoding-based species identification process, offering recommendations for robust workflows and effective communication of findings. Accurate interpretation and communication of eDNA metabarcoding results requires an acknowledgment of methodological limitations such as incomplete reference databases, contamination risks, ambiguous sequences, and detection biases. Thus, we argue that transparency of methods and limitations, alongside proactive alignment of decisions with project objectives are critical for the successful application of eDNA metabarcoding in conservation and management decisions. We provide guidance for developing protocols that support species identification from eDNA metabarcoding sequences, and give recommendations on communication strategies for stakeholders and end users. To support these recommendations, we outline steps in the workflow that can impact species identification, with a discussion of the strengths and weaknesses at each stage. Ultimately, this guidance can improve the accuracy, reliability, and usability of eDNA and other metabarcoding and amplicon sequencing approaches to species identification while fostering trust and understanding among diverse end users.},
	issn = {},
	pages = {e174450},
	URL = {https://doi.org/10.3897/mbmg.10.174450},
	eprint = {https://doi.org/10.3897/mbmg.10.174450},
	journal = {Metabarcoding and Metagenomics}
}



